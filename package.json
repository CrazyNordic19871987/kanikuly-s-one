{
  "name": "kanikuly-s-one",
  "version": "3.6.1",
  "description": "Каникулы с ONE! — summer camp management SPA (GitHub Pages, Vite)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write js/**/*.js",
    "format:check": "prettier --check js/**/*.js",
    "dev": "vite",
    "build": "vite build && node -e \"import{cpSync}from'fs';cpSync('js','dist/js',{recursive:true})\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "jspdf": "^4.2.1",
    "prettier": "^3.9.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
